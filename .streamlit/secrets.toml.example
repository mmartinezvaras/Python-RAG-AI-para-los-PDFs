# Settings for the free online demo on Streamlit Community Cloud.
# Paste these into the app's "Secrets" box (Advanced settings) — never commit real keys.
# Get a free key at https://aistudio.google.com/apikey and check there which models
# your key can use (Google changes the free-tier models and limits from time to time).

RAG_LLM_PROVIDER = "openai"
RAG_EMBEDDINGS = "openai"
OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
OPENAI_API_KEY = "your-gemini-api-key"
RAG_LLM_MODEL = "gemini-3.8-flash"
RAG_EMBED_MODEL = "gemini-embedding-001"
# Similarity scores depend on the embedding model: calibrate with
# `python -m eval.run_eval --retrieval-only` using these same settings.
RAG_MIN_RELEVANCE = "0.45"

# Public demo: no uploads, and a question limit per visitor.
RAG_PUBLIC_DEMO = "1"
