{
  "name": "RAG over PDFs (one-click demo)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "postAttachCommand": {
    "demo": "bash scripts/run_app.sh"
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "RAG demo",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
